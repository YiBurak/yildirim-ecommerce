# ==============================================================================
# YILDIRIM E-COMMERCE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Projeyi yerelde calistirmadan once bu dosyayi '.env' olarak kopyalayip 
# kendi sandbox / test bilgilerinizi giriniz.
# ==============================================================================

# 🔑 1. JWT GİZLİ ANAHTARI (En az 32 karakter, kriptografik)
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_2026!

# 📬 2. RABBITMQ GÜVENLİ KULLANICI & ŞİFRESİ
RABBITMQ_USER=ecommerce_user
RABBITMQ_PASS=ecommerce_pass_2026!

# ⚡ 3. REDIS KORUMA ŞİFRESİ (requirepass)
REDIS_PASS=redis_secure_pass_2026!

# 🐘 4. POSTGRESQL VERİTABANI BİLGİLERİ
POSTGRES_DB=EnterpriseECommerceDb
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=postgres_secure_pass_2026!

# 💳 5. IYZICO SANDBOX AYARLARI
IYZICO_API_KEY=sandbox-your-iyzico-api-key
IYZICO_SECRET_KEY=sandbox-your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# 📧 6. SMTP / E-POSTA AYARLARI (MailKit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_SENDER_EMAIL=your_email@gmail.com

# 🌐 7. CLIENT / FRONTEND DOMAIN URL
CLIENT_URL=http://localhost

